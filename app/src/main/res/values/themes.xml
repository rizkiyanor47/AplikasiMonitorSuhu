<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AplikasiMonitorSuhu" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/orange_start</item>
        <item name="colorPrimaryVariant">@color/purple_end</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/tofu_orange</item>
        <item name="colorSecondaryVariant">@color/tofu_brown</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Gaya untuk Foto Profil Bulat -->
    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>
</resources>