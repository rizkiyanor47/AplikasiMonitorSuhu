<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fitsSystemWindows="true">

    <View
        android:id="@+id/white_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginVertical="80dp"
        android:background="@drawable/bg_white_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/logo_placeholder"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="64dp"
        android:contentDescription="@string/desc_logo_tofu"
        android:src="@drawable/suhutahu"
        app:layout_constraintEnd_toEndOf="@id/white_card"
        app:layout_constraintStart_toStartOf="@id/white_card"
        app:layout_constraintTop_toTopOf="@id/white_card" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/title_tofumonitor"
        android:textColor="@color/tofu_brown"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/white_card"
        app:layout_constraintStart_toStartOf="@id/white_card"
        app:layout_constraintTop_toBottomOf="@id/logo_placeholder" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/subtitle_splash"
        android:textColor="@color/tofu_orange"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/white_card"
        app:layout_constraintStart_toStartOf="@id/white_card"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyle"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/tofu_orange"
        app:layout_constraintBottom_toTopOf="@+id/tv_politala_label"
        app:layout_constraintEnd_toEndOf="@id/white_card"
        app:layout_constraintStart_toStartOf="@id/white_card"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle" />

    <TextView
        android:id="@+id/tv_politala_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:text="@string/label_politala"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:drawableStartCompat="@drawable/politala"
        app:layout_constraintBottom_toBottomOf="@id/white_card"
        app:layout_constraintEnd_toEndOf="@id/white_card"
        app:layout_constraintStart_toStartOf="@id/white_card" />

    <TextView
        android:id="@+id/tv_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="@string/footer_splash"
        android:textColor="@color/tofu_brown"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
